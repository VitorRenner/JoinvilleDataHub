# ============================== Ambiente ==============================
ENVIRONMENT=development
DEBUG=True

# ===================== Banco de dados (obrigatório) ===================
DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/caged_db

# ============================ CORS (front) ============================
# Lista em formato JSON com as origens liberadas (ex.: site Nexus)
CORS_ORIGINS=["http://localhost:3000"]

# ================================ CAGED ===============================
# Publicação mensal: verificação diária, no horário abaixo (0-23)
SCHEDULER_CAGED_HORA=2

# ============================ CEMPRE (IBGE) ===========================
CEMPRE_BASE_URL=https://apisidra.ibge.gov.br
# Publicação anual: job mensal em data fixa (dia 1º, às 3h)
SCHEDULER_CEMPRE_DIA=1
SCHEDULER_CEMPRE_HORA=3

# ============================ RFB (CNPJ) ==============================
# Obrigatório para a atualização da RFB.
# Token = última parte do link público:
# arquivos.receitafederal.gov.br/index.php/s/<TOKEN>
RFB_SHARE_TOKEN=coloque_o_token_aqui
# Publicação mensal sem data exata: job todo dia 15, às 4h
SCHEDULER_RFB_DIA=15
SCHEDULER_RFB_HORA=4

# ======================= Agente /perguntar (Gemini) ========================
# Chave do Google AI Studio. Vazia = rota /perguntar desligada (503).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AGENTE_MAX_PASSOS=5
AGENTE_THINKING_LEVEL=minimal
AGENTE_LIMITE_POR_MINUTO=5
AGENTE_LIMITE_DIARIO=200
