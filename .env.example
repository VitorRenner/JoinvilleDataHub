# Ambiente
ENVIRONMENT=development
DEBUG=True

# Banco de dados (obrigatório)
DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/caged_db

# Fontes de dados (opcional — já possuem valor padrão em src/core/settings.py)
CAGED_BASE_URL=https://portaldatransparencia.gov.br
IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v1

# Scheduler (opcional — intervalo em segundos entre atualizações automáticas)
# O Novo CAGED é publicado mensalmente; 86400 = verifica uma vez por dia.
SCHEDULER_INTERVAL_SECONDS=86400
